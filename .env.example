# SatıcıPilot — Ortam Değişkenleri
# Bu dosyayı kopyala: cp .env.example backend/.env

# ── Supabase ──────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Veritabanı (doğrudan bağlantı) ────────
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...          # Opsiyonel

# ── Auth ──────────────────────────────────
SECRET_KEY=supersecretkey-change-this-in-production

# ── Trendyol ──────────────────────────────
# Satıcı bazlı; DB'de saklanır, burada örnek değer
TRENDYOL_API_URL=https://api.trendyol.com/sapigw

# ── Sentry (opsiyonel) ────────────────────
SENTRY_DSN=

# ── Frontend ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
